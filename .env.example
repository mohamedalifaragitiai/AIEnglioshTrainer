# AI English Coach — environment overrides (copy to .env). Prefix: COACH_
# All values are optional; defaults live in config/settings.py.

# --- Serving ---
COACH_APP_HOST=127.0.0.1
COACH_APP_PORT=8000
COACH_LOG_LEVEL=INFO
COACH_LOG_JSON=true

# --- Resource governance (the 96% ceiling) ---
# Hard per-resource ceiling. Do NOT raise without understanding the freeze risk.
COACH_RESOURCE_CEILING=0.96
# Soft threshold: begin shedding optional (cold-path) work.
COACH_RESOURCE_SOFT=0.88
COACH_SAMPLE_INTERVAL_S=1.0
COACH_ROLLING_WINDOW=3
COACH_HYSTERESIS_MARGIN=0.06

# Degradation-ladder entry thresholds (peak usage ratio across resources).
COACH_LADDER_L1=0.88
COACH_LADDER_L2=0.92
COACH_LADDER_L3=0.94
COACH_LADDER_L4=0.96

# --- VRAM budgeting for co-residency (Phase 2+) ---
# Fraction of total VRAM vLLM reserves statically at startup. The guard treats
# this as a fixed pre-committed block, not free VRAM. Lower this first if the
# startup budget check reports the resident set won't fit under the 96% ceiling.
COACH_VLLM_VRAM_FRACTION=0.68

# --- Model serving (Phase 2) ---
# Loading is OFF by default so the app boots without weights. Turn on only after
# setup_models.py has fetched weights and (for the LLM) a vLLM server is running.
COACH_LOAD_MODELS=false

# vLLM runs as a SEPARATE process (native Linux/WSL2 on Windows), OpenAI-compatible.
COACH_VLLM_BASE_URL=http://127.0.0.1:8001
COACH_VLLM_HOT_MODEL=Qwen/Qwen3-8B
COACH_VLLM_COLD_MODEL=Qwen/Qwen3-14B

# Resident GPU models + estimated VRAM (benchmark_models.py refines these).
COACH_ENABLE_STT=true
COACH_STT_MODEL=large-v3-turbo
COACH_STT_DEVICE=cuda
COACH_STT_VRAM_GB=1.8
COACH_ENABLE_GOP=true
COACH_GOP_DEVICE=cuda
COACH_GOP_VRAM_GB=1.6
COACH_ENABLE_TTS=true
COACH_TTS_DEVICE=cuda
COACH_TTS_VRAM_GB=0.6

# --- Hot path (Phase 3) ---
COACH_HOTPATH_SAMPLE_RATE=16000
COACH_HOTPATH_REPLY_MAX_TOKENS=200
COACH_FIRST_AUDIO_BUDGET_MS=300
# VAD: 'energy' (offline, no deps) or 'silero' (optional, needs torch)
COACH_VAD_BACKEND=energy
COACH_VAD_FRAME_MS=20
COACH_VAD_ENERGY_THRESHOLD=0.02
COACH_VAD_SILENCE_HANGOVER_MS=500
COACH_VAD_MIN_SPEECH_MS=200
# Where learner-turn audio is written for cold-path re-analysis (unset = off)
# COACH_AUDIO_DIR=./data/audio

# --- Paths (models live outside the repo) ---
# COACH_DATA_DIR=./data
# COACH_MODELS_DIR=./models

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# uv / venv
.venv/

# Local config & data
.env
/data/
/models/
/reports/

# Screenshots dropped in the tree while debugging. The repo is public, so these
# stay local by default; design/*.png is committed deliberately and is unaffected.
Screenshot*.png
screenshot*.png
Screen Shot*.png
# Any image dropped at the top level: those are pastes, not assets. Named
# differently every time, so match the location rather than chase the names.
/*.png
/*.jpg
/*.jpeg

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Machine-local npm cache redirect (RESUME.md, Profile B). Points at an M:\n# path that exists on exactly one machine, so it must never be tracked.
frontend-next/.npmrc

# Normalize line endings: LF in the repo AND in the working tree (eol=lf), so a
# checkout on Windows matches what WSL and CI see. The catch-all covers everything;
# the per-type lines are explicit for the file kinds this repo actually holds.
* text=auto eol=lf

# Backend / tooling
*.py text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.yml text eol=lf
# CRLF in a shell script breaks it under WSL ("bad interpreter") — never let it in.
*.sh text eol=lf

# Frontend
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf

# Docs
*.md text eol=lf

# Binary — never touch these
*.png binary
*.wav binary
